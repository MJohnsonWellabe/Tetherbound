# Godot 4 editor cache and import artifacts. Regenerated on open; committing
# them causes noisy diffs and cross-machine conflicts.
.godot/
.import/

# Export output. Built by `godot --export-*`, never checked in.
/build/
*.exe
*.pck
*.zip

# Godot writes these next to the project on some platforms.
export_presets.cfg.bak
*.translation

# The editor's per-user settings, which are machine-specific.
.vscode/
.idea/
*.tmp

# OS noise
.DS_Store
Thumbs.db

# Raw asset downloads awaiting import. Only committed, licence-logged output
# belongs under assets/. See docs/ASSET_LEDGER.md.
assets_raw/

# Godot's own crash/log output
logs/
*.log

# Survey output. Regenerate with tools/survey.sh + tools/contact_sheet.gd.
shots/
shots-*/

# Python bytecode from the art pipeline tools
__pycache__/
*.pyc

# Subagent worktrees, created by the Agent tool for isolated parallel work
.claude/worktrees/

# Godot sidecars for the download page's JPEGs. `site/` lives inside the
# project, so the editor imports them as textures; they are useless on a
# website and get published to Pages. site/README.md has said not to commit
# these since the page was written -- they were committed anyway.
site/img/*.import
