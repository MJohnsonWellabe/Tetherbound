# Godot 4 editor cache and import artifacts. Regenerated on open; committing
# them causes noisy diffs and cross-machine conflicts.
.godot/
.import/

# Export output. Built by `godot --export-*`, never checked in.
/build/
*.exe
*.pck
*.zip

# Godot writes these next to the project on some platforms.
export_presets.cfg.bak
*.translation

# The editor's per-user settings, which are machine-specific.
.vscode/
.idea/
*.tmp

# OS noise
.DS_Store
Thumbs.db

# Raw asset downloads awaiting import. Only committed, licence-logged output
# belongs under assets/. See docs/ASSET_LEDGER.md.
assets_raw/

# Godot's own crash/log output
logs/
*.log

# Survey output at the REPOSITORY ROOT. Regenerate with tools/survey.sh +
# tools/contact_sheet.gd.
#
# Anchored with a leading slash, and that slash is load-bearing. Unanchored,
# `shots/` matched EVERY shots directory at every depth -- including
# `ralph/reports/gate-f-run-*/<segment>/shots/`, which is where
# `operator_harness.gd` writes every prescribed Gate F capture and its
# `manifest.json`. That is the mechanism behind coverage defect CD-2: the
# harness created the directory and wrote into it, git silently declined to
# track any of it, and a full Gate F run landed on the branch with no
# prescribed screenshot in it anywhere. The captures were taken; the evidence
# was swallowed on the way to the commit.
/shots/
/shots-*/
# Scratch capture directories written by one-off VP render scripts
# (res://shots_world_r3, res://shots_dawn_verify, ...). Same anchored form
# and the same reasoning as the two lines above: only at the repo root, so
# nothing nested under ralph/reports/ is ever swallowed.
/shots_*/

# Python bytecode from the art pipeline tools
__pycache__/
*.pyc

# Subagent worktrees, created by the Agent tool for isolated parallel work
.claude/worktrees/

# Godot sidecars for the download page's JPEGs. `site/` lives inside the
# project, so the editor imports them as textures; they are useless on a
# website and get published to Pages. site/README.md has said not to commit
# these since the page was written -- they were committed anyway.
site/img/*.import

# throwaway lane capture/probe scripts, by convention run-and-deleted, never shipped
tools/_scratch_*

# CREATURE-IDENTITY-2 anatomy maps: UV-space position/normal rasterisations
# derived from the creature glbs by tools/creature_anatomy_maps.py. Pure
# derived data, a few MB each, rebuilt in about a second per species.
*_anatomy.npz

# T1-CAST: tools/regrade_tether_textures.py keeps a local pre-regrade copy of
# each atlas it edits. Git history is the real backup; these are 4MB each and
# do not belong in the tree.
*_lod0_texture_0.orig.png

# Evidence payloads. Capture rounds and telemetry under ralph/reports/ grew to
# 2.8 GB in three days. Only written verdicts (*.md) and one contact sheet
# (_sheet*.png) per round belong in the tree; per-frame captures and telemetry
# stay local or attach to the CI run.
#
# Written as plain ignores, no `!` negations: `git check-ignore` reports a
# negated match with exit 0 too, and both tests/test_gate_f_rig.gd and the
# Gate F harness's own _uncommittable() read exit 0 as "git will not carry
# this". Gate F run directories (ralph/reports/gate-f-*/) are therefore not
# named here at all: the protocol requires their prescribed captures and
# save handoffs to be committed (CD-2). Everything else is.
ralph/reports/visual-parity/**/[!_]*.png
ralph/reports/visual-parity/**/[!_]*.jpg
ralph/reports/audit/**/[!_]*.png
ralph/reports/audit/**/[!_]*.jpg
ralph/reports/judge-*/**/[!_]*.png
ralph/reports/hud-catch/**/[!_]*.png
ralph/reports/shots/**/[!_]*.png
ralph/reports/T[0-9]-*/**/[!_]*.png
ralph/reports/T[0-9]-*/**/[!_]*.jpg
ralph/reports/t[0-9]-*/**/[!_]*.png
ralph/reports/OWNER-*/**/[!_]*.png
ralph/reports/WORLD-*/**/[!_]*.png
ralph/reports/CAMP-*/**/[!_]*.png
ralph/reports/HUD-*/**/[!_]*.png
ralph/reports/TOURNAMENT-*/**/[!_]*.png
ralph/reports/HARNESS-*/**/[!_]*.png
ralph/reports/OPENING-*/**/[!_]*.png
ralph/reports/**/*.jsonl
ralph/reports/**/*.csv
ralph/reports/**/telemetry/

# Historical material lives in archive/; nothing there is loaded by the game.
