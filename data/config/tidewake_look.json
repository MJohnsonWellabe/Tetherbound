   "_why_round2": "F13#5 r1 judges: seat houses (paths, tufts), a third house, and dress the empty foreground with driftwood, rocks and straw grass.",
   "_why_round3": "r3: Meshy fisher hut replaces one cottage per dock (maritime building, box collider inside its footprint); Meshy dock shelter, net rack, fish crates, lobster pots, beach grass and dune shrubs replace generic fantasy props.",
   "_why_round4": "r4: the fixed dock camera stands 20 m inland, so harbour work must sit near it: a rowboat drawn up on the sand and a net rack beside each hamlet; fisher hut at 6 m to match the cottages.",
   "_why_round5": "r5: the first two buildings flank the approach at +/-8.5 m, 12-13 m back, so the walk down to the pier reads as a short harbour street from the fixed camera."
  },
  "current_flow": {"_comment": "F13#5 candidate under this OFF gate. r1: removing the painted rims alone lost the direction read. r2: the lane reads as rougher, darker moving water: standing crests over the lane, a deeper channel tint, bright tapered foam comets, thin chevrons only as a faint secondary hint, and twice the drifting driftwood/kelp with pennant buoys. Flow vectors, strengths and restored state unchanged. r4: chevrons off entirely (judges read every chevron as road paint); foam breaks up more. r5: channel tint back to a faint 0.14 (r4 judges read its hard-edged band as a floating translucent panel).", "state_shader": {"live": {"channel_edge_opacity": 0.0, "channel_tint_opacity": 0.14, "chevron_opacity": 0.0, "comet_opacity": 0.35, "brightness": 1.15, "fleck_amount": 0.9, "opacity": 1.0}}, "shader": {"chevron_thickness_m": 0.7, "chevron_width_m": 10.0, "comet_length_m": 14.0, "comet_fill": 0.8, "channel_tint_colour": "#2c5f80"}, "drift_markers": {"spacing_m": 18.0, "max_per_lane": 22, "floaters": [{"model": "res://assets/environment/nature/log.glb", "scale": 2.4}, {"model": "res://assets/environment/nature/grass_leafsLarge.glb", "scale": 4.0}], "buoy": {"model": "res://assets/props/meshy-1020/tidewake_current_buoy_marker/tidewake_current_buoy_marker.glb", "scale": 0.9, "pole_m": 2.4, "at_fractions": [0.2, 0.45, 0.7, 0.9]}}},
  "current_flow_visual": {"_comment": "F13#5 r2 under this OFF gate: grouped foam on with standing crests (P2-066 candidate's second gate), denser brighter groups.", "enabled": true, "ridges_enabled": true, "shader": {"visual_density": 0.78, "visual_band_gain": 0.85, "visual_ridge_gain": 0.9, "visual_breakup": 1.0}},
