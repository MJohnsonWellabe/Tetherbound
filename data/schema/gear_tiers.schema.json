{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tetherbound/gear_tiers",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "enum": [
          "gear_tier_1",
          "gear_tier_2",
          "gear_tier_3",
          "gear_tier_4",
          "gear_tier_5",
          "gear_tier_6",
          "gear_tier_7",
          "gear_tier_8"
        ]
      },
      "tier": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8
      },
      "biome": {
        "type": "string",
        "enum": [
          "meadows",
          "tidewake",
          "cloudreach",
          "stormwood",
          "biome5",
          "biome6",
          "biome7",
          "biome8"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "live",
          "reserved"
        ]
      },
      "slots": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "harness",
            "charm"
          ]
        },
        "minItems": 2,
        "uniqueItems": true,
        "maxItems": 2
      },
      "max_upgrade": {
        "const": 3
      }
    },
    "required": [
      "id",
      "tier",
      "biome",
      "status",
      "slots",
      "max_upgrade"
    ],
    "additionalProperties": false,
