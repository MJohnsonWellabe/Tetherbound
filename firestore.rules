rules_version = '2';

// TETHERBOUND, single-player cloud checkpoints.
//
// Every path is per-user. There is no shared data, no leaderboard and no
// public read anywhere in this file. Firestore denies unlisted paths by
// default; the catch-all at the bottom states that intent explicitly so a
// later edit cannot widen it by accident.
//
// On the party cap: CLAUDE.md makes five a hard constraint, and Party.add() is
// its single enforcement point. These rules add a server-side assertion on the
// denormalised partyCount so a document CLAIMING six is rejected outright.
// They cannot see inside the compressed payload, which is an accepted limit
// and is written up in DECISIONS.md D15: this is a single-player game with no
// economy, cheating your own save harms nobody, and parseSave() clamps to five
// on every load path regardless.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null
          && request.auth.uid == uid
          // Anonymous auth is deliberately not enabled for this project
          // (DECISIONS.md D11). Refusing it here too means switching it on by
          // accident can never start minting orphan saves.
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Firestore's hard ceiling is 1 MiB per document. Stopping well short
    // leaves room for the header fields and Firestore's own overhead, and
    // turns a runaway structures[] into a clean client-side refusal rather
    // than an opaque server error. payload is base64, so chars == bytes.
    function payloadOk(d) {
      return d.payload is string
          && d.payload.size() > 0
          && d.payload.size() <= 700000;
    }

    function checkpointShape(d) {
      return d.keys().hasAll([
               'schemaVersion','rev','savedAt','serverSavedAt','codec',
               'bytes','checksum','partyCount','seed','payload'
             ])
          && d.keys().hasOnly([
               'schemaVersion','rev','savedAt','serverSavedAt','deviceId',
               'deviceLabel','codec','bytes','checksum','partyCount',
               'seed','day','payload'
             ])
          && d.schemaVersion == 1
          && d.rev is int && d.rev >= 1
          && d.savedAt is int && d.savedAt > 0
          // Pins the write to the SERVER's clock. A device with a wrong or
          // deliberately-set clock cannot forge a save's ordering.
          && d.serverSavedAt == request.time
          && d.codec in ['json', 'gzip-b64']
          && d.checksum is string && d.checksum.size() <= 32
          && d.seed is string && d.seed.size() > 0 && d.seed.size() <= 64
          && d.bytes is int && d.bytes >= 0 && d.bytes <= 4000000
          && d.partyCount is int && d.partyCount >= 0 && d.partyCount <= 5
          && (!('day' in d) || (d.day is int && d.day >= 0 && d.day <= 100000))
          && (!('deviceId' in d) || (d.deviceId is string && d.deviceId.size() <= 64))
          && (!('deviceLabel' in d) || (d.deviceLabel is string && d.deviceLabel.size() <= 64))
          && payloadOk(d);
    }

    function headerShape(d) {
      return d.keys().hasAll(['schemaVersion','rev'])
          && d.keys().hasOnly([
               'schemaVersion','displayName','createdAt','lastSeenAt','rev',
               'savedAt','seed','day','timeOfDay','badges','party','playMs',
               'deviceLabel','bytes','codec'
             ])
          && d.schemaVersion == 1
          && d.rev is int && d.rev >= 0
          && (!('party' in d) || (d.party is list && d.party.size() <= 5))
          && (!('badges' in d) || (d.badges is list && d.badges.size() <= 8))
          && (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 40))
          && (!('seed' in d) || (d.seed is string && d.seed.size() <= 64))
          && (!('deviceLabel' in d) || (d.deviceLabel is string && d.deviceLabel.size() <= 64));
    }

    // The hot header: everything the Continue card needs, in one small read.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && headerShape(request.resource.data);

      // rev is monotone, so a device holding a stale copy cannot walk the
      // header backwards and advertise a save older than the blob really is.
      allow update: if isOwner(uid)
                    && headerShape(request.resource.data)
                    && request.resource.data.rev >= resource.data.rev;

      // The player owns their data and may delete it.
      allow delete: if isOwner(uid);

      // The cold blobs.
      match /saves/{slot} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
                      && slot in ['current', 'rollback']
                      && checkpointShape(request.resource.data);

        // STRICT monotonicity on `current` is the cross-device safety net: a
        // device that has been offline holding rev 7 physically cannot
        // overwrite a rev 12 written from the player's other phone. The write
        // fails with permission-denied, which the client re-reads and turns
        // into the Choose-a-save screen instead of silent data loss.
        //
        // `rollback` is exempt on purpose. It is the displaced slot and its
        // rev legitimately moves in both directions.
        allow update: if isOwner(uid)
                      && slot in ['current', 'rollback']
                      && checkpointShape(request.resource.data)
                      && (slot == 'rollback'
                          || request.resource.data.rev > resource.data.rev);

        allow delete: if isOwner(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
