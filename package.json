{
  "name": "tetherbound",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-world survival-craft creature-collector. Three biomes of ambition, one that ships.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/optimize-assets.mjs",
    "decisions": "node tools/decisions.mjs",
    "smoke": "playwright test",
    "smoke:update": "playwright test --update-snapshots",
    "survey": "node tools/survey.mjs",
    "feelcheck": "node tools/feelcheck.mjs",
    "sheet": "node tools/sheet.mjs",
    "holes": "node tools/holes.mjs",
    "drawcost": "node tools/drawcost.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.30.0",
    "@babylonjs/loaders": "^8.30.0",
    "firebase": "^12.15.0",
    "howler": "^2.2.4",
    "simplex-noise": "^4.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/howler": "^2.2.12",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
