; Tetherbound — Godot project settings.
;
; Engine is LOCKED to Godot 4 (docs/GAME_DESIGN.md §4). Pinned to 4.7-stable;
; see docs/decisions/D01-godot-version-and-renderer.md before changing it.
;
; Most of this file is the input map. It is here rather than in code because
; docs/TECHNICAL_START.md §Input requires actions, never raw device checks
; scattered through gameplay. Every action carries a keyboard/mouse binding AND
; an Xbox-layout gamepad binding, because controller is the primary input and
; keyboard is the fallback, not the other way round.

config_version=5

[application]

config/name="Tetherbound"
config/description="Third-person survival creature-training game. Meadows vertical slice."
run/main_scene="res://scenes/world/meadows_playground.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

; One autoload, and a high bar for the next one. SaveManager is here because the
; save file must outlive every scene that contributes to it — a system that
; unloads mid-session still has to have been written. Systems that live inside a
; scene stay inside that scene.
SaveManager="*res://autoload/save_manager.gd"

[display]

; ROG Ally is 1920x1080 at 7 inches. Authoring at native resolution and letting
; canvas_items stretch handles desktop windows without a second UI layout, and
; keeps HUD text legible at handheld pixel density.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

; The Ally's sticks rest slightly off-centre. 0.2 is a starting value and is
; tunable; anything lower produces camera drift on a worn pad.
pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="forward_plus"
; Shadows are the single defect that killed the previous prototype. Godot gives
; real directional shadows out of the box; these are just the defaults made
; explicit so nobody has to guess what they were.
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.23, 0.44, 0.58, 1)

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87,"pressed":false,"script":null)
, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":-1.0,"script":null)
]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83,"pressed":false,"script":null)
, Object(InputEventJoypadMotion,"device":-1,"axis":1,"axis_value":1.0,"script":null)
]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65,"pressed":false,"script":null)
, Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0,"script":null)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68,"pressed":false,"script":null)
, Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0,"script":null)
]
}
look_up={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":-1.0,"script":null)
]
}
look_down={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":3,"axis_value":1.0,"script":null)
]
}
look_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":-1.0,"script":null)
]
}
look_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":2,"axis_value":1.0,"script":null)
]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":0,"pressed":false,"script":null)
]
}
sprint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194325,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":7,"pressed":false,"script":null)
]
}
interact={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":2,"pressed":false,"script":null)
]
}
inventory={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":73,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":3,"pressed":false,"script":null)
]
}
; The party moved off gamepad Y in M9 (it collided with `inventory` — one press
; of Y fired both actions and only one screen could ever win), took the Start
; button, and has now moved again: Start is the PAUSE MENU, the owner's "there
; doesn't seem to be a menu button", and the party is a row ON that menu. The
; party is not stranded — `pause_menu` below opens a menu whose second row is
; the party — so this action keeps only keyboard P, unchanged since M4, and no
; pad button at all. Giving it one would repeat the exact collision M9 resolved,
; because every face, shoulder and D-pad button on an Xbox layout is now spoken
; for; the input map is where that gets resolved, not the code that reads it.
party_menu={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":80,"pressed":false,"script":null)
]
}
; The front door to every screen: Resume / Party / Inventory / Map / Settings /
; Save & Quit. Start, because on an Xbox-layout handheld Start IS the menu
; button — the owner reached for it and found nothing there.
;
; Keyboard is TAB, NOT ESCAPE, and that is a collision decision, not taste:
; Escape is already `menu_cancel` AND `combat_run`, so an Escape-bound pause
; would open the menu on the same frame the fight reads "flee" — the two-
; actions-one-frame failure recorded twice in this file. Tab is bound to
; nothing, sits under the left hand at WASD, and toggles the same way it opens
; map overlays in every survival game on PC.
pause_menu={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":6,"pressed":false,"script":null)
]
}
map={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":77,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":4,"pressed":false,"script":null)
]
}
; M8 tools. Build mode used to borrow this to rotate its ghost, which meant
; rebinding "cycle tool" silently rebound "rotate the wall". It has its own
; action now; this one is the tool cycle again and nothing reads it yet.
tool_cycle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":81,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":9,"pressed":false,"script":null)
]
}
build_toggle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":66,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":10,"pressed":false,"script":null)
]
}
; Build mode's own palette controls. They share the D-pad with the combat pal
; switch on purpose — cycling is what a D-pad is for, and the two modes cannot
; be open at once (`build_mode._set_open` refuses to open mid-fight). Sharing a
; BUTTON is fine; sharing an ACTION is what went wrong, because it made the two
; features impossible to rebind separately and hid the pal switch behind a
; building feature. Keyboard is , / . / R, the building-game idiom.
build_cycle_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":44,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":13,"pressed":false,"script":null)
]
}
build_cycle_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":46,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":14,"pressed":false,"script":null)
]
}
build_rotate={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":82,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":11,"pressed":false,"script":null)
]
}
; M12's mount/dismount. A NEW ACTION, after checking that no existing one fits.
;
; `interact` is the obvious candidate and it is the wrong one. It is already
; read by three systems — `encounter_director` engages a wild pal within 6m,
; `doors` opens a door, `satchel` loots a bag — and mounting collides with the
; first of those in a way nothing can arbitrate: calling your mount and engaging
; a creature are both legal with a rideable pal in the party and a wild pal in
; range, so one press would do both, in the same frame, forever. That is exactly
; the failure the `party_menu` comment below records — two actions on gamepad Y,
; one press firing both, only one screen ever winning — and it was resolved
; there in the input map rather than papered over in the code that reads it.
;
; The button is the D-PAD DOWN, which is the only face, shoulder or D-pad button
; on an Xbox layout that nothing in this file binds: up is `build_rotate`, left
; and right are `build_cycle_*` and `combat_switch_*` sharing on purpose. The
; gallop is not here — it is `sprint`, because that button already means "go
; faster" and the trainer's own legs are not being used.
;
; Keyboard G, which is free and under the left hand at WASD.
mount={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":71,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":12,"pressed":false,"script":null)
]
}
combat_quick={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":0,"pressed":false,"script":null)
]
}
combat_charged={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":2,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":2,"pressed":false,"script":null)
]
}
combat_throw={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":70,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":10,"pressed":false,"script":null)
]
}
combat_run={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":1,"pressed":false,"script":null)
]
}
; Reserved for the M4 party: swapping the deployed pal mid-fight. Nothing else
; may read these — build mode did, and it made the pal switch un-rebindable.
combat_switch_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194319,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":13,"pressed":false,"script":null)
]
}
combat_switch_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194321,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":14,"pressed":false,"script":null)
]
}
menu_confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194309,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":0,"pressed":false,"script":null)
]
}
menu_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194305,"pressed":false,"script":null)
, Object(InputEventJoypadButton,"device":-1,"button_index":1,"pressed":false,"script":null)
