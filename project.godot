; Tetherbound — Godot project settings.
;
; Engine is LOCKED to Godot 4 (docs/GAME_DESIGN.md §4). Pinned to 4.7-stable;
; see docs/decisions/D01-godot-version-and-renderer.md before changing it.
;
; Most of this file is the input map. It is here rather than in code because
; docs/TECHNICAL_START.md §Input requires actions, never raw device checks
; scattered through gameplay. Every action carries a keyboard/mouse binding AND
; an Xbox-layout gamepad binding, because controller is the primary input and
; keyboard is the fallback, not the other way round.

config_version=5

[application]

config/name="Tetherbound"
config/description="Third-person survival creature-training game. Meadows vertical slice."
run/main_scene="res://scenes/ui/title_screen.tscn"
; "GL Compatibility", not "Forward Plus". RB4 switched the shipped renderer
; (see docs/decisions/D01) and left this tag reading the old value, so the file
; contradicted itself for two days: this line said Forward+ while
; rendering/rendering_method below said gl_compatibility.
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[editor]

; Parallel import races file hashing on Windows in this asset-heavy project.
; Serial import is slower on a cold checkout, but deterministic on the primary platform.
import/use_multiple_threads=false

[autoload]

; The project's one singleton, and it is meant to stay the only one. It owns the
; party, the satchel and the day, and it stands up the pause menu so the menu
; exists in every scene rather than being instanced into each world by hand.
; See autoload/game_state.gd.
Game="*res://autoload/game_state.gd"

[display]

; ROG Ally is 1920x1080 at 7 inches. Authoring at native resolution and letting
; canvas_items stretch handles desktop windows without a second UI layout, and
; keeps HUD text legible at handheld pixel density.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

; The Ally's sticks rest slightly off-centre. 0.2 is a starting value and is
; tunable; anything lower produces camera drift on a worn pad.
pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
; Shadows are the single defect that killed the previous prototype. Godot gives
; real directional shadows out of the box; these are just the defaults made
; explicit so nobody has to guess what they were.
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
; SA1, the Ally memory investigation: neither atlas size had ever been set, so
; both sat at Godot's 4096 desktop default -- roughly 67 MB each, ~134 MB of
; render target, on a handheld whose VRAM is the same DDR5 the game is already
; saturating. 2048 halves each side, so a quarter of the memory, and the sun is
; the only shadow-caster that matters outdoors. Raise it back if shadow edges
; visibly stair-step on device; that is the trade being made here.
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=2048
; Was 2 (= MSAA 4x): ~66 MB of extra colour and depth at 1920x1080. Dropped to
; 1 (= 2x) for the same shared-memory reason. NOT zero, deliberately: R9.4
; enabled alpha-to-coverage on foliage, which needs MSAA to do anything at all,
; and the foliage mipmap fix in the same commit as this line is the other half
; of that problem.
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.23, 0.44, 0.58, 1)

