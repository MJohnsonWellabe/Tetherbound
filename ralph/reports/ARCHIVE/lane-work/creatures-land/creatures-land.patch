+        return None, None
+    samples = np.asarray(samples)
+    widths = np.asarray(widths)
+    bolt_tree = cKDTree(samples)
+    halo_scale = float(spec.get("halo_scale", 3.0))
+    all_pts = unit[valid] * extent
