  "art_world_lighting": [
    {
      "id": "C1",
      "severity": "full_quality_bar_failure",
      "scope": "all 54 frames",
      "finding": "Dense repeated thin bright grass blades and scattered flower stems compete with feet and ground cues; mottled yellow-green ground and conspicuous hard shadows produce a noisy combat field. The references have more controlled vegetation grouping and focal hierarchy.",
      "examples": [
        "00-030.png",
        "04-060.png",
        "06-030.png",
        "08-179.png"
      ]
    },
    {
      "id": "C2",
      "severity": "full_quality_bar_failure",
      "scope": "all 54 frames",
      "finding": "HUD uses a plain single-color square where an actor identity image would be expected, large dark rectangular panels and uneven emphasis. In faded states, text/bar contrast becomes poor against vegetation. These pixels do not meet the requested finished presentation bar; no claim about the implementation reason.",
      "examples": [
        "00-030.png",
        "04-090.png",
        "04-120.png",
        "07-060.png",
        "07-090.png"
      ]
    },
    {
      "id": "C3",
      "severity": "full_quality_bar_failure",
      "scope": "giant-containing pairs 02,05,06,07,08",
      "finding": "Giant stag chest/face and limbs have broad near-black areas with little visible internal tonal detail; bright mint-green neck patches and cream antler masses read as abrupt blocks. Compared with the restored creature board, the material transitions and organic detail are coarse. This does not by itself erase the actor's overall identity.",
      "examples": [
        "02-030.png",
        "05-030.png",
        "06-000.png",
        "08-030.png"
      ]
    },
    {
      "id": "C4",
      "severity": "full_quality_bar_failure",
      "scope": "visible effect moments across all pairs",
      "finding": "Large flat beige radial polygons, pale circular flash and dust sheets wash over creature surfaces; magenta ground rings are conspicuous, flat and poorly integrated with the grass. Their basic shapes are readable, but the craft is below the reference effects.",
      "examples": [
        "00-000.png",
        "00-120.png",
        "01-120.png",
        "04-120.png",
        "07-120.png",
        "08-090.png"
      ]
    },
    {
      "id": "C5",
      "severity": "presentation_defect",
      "scope": "many frames outside pair 00",
      "finding": "Noncombat creatures repeatedly crowd the fight foreground and are cut by the viewport or buried beneath controls. Human bystander is sometimes largely hidden, covered by HUD or clipped at the bottom. These are actual presentation defects, not evidence that the two primary combatants are themselves viewport-clipped.",
      "examples": [
        "03-060.png",
        "03-120.png",
        "06-179.png",
        "07-120.png",
        "08-179.png"
      ]
    },
    {
      "id": "C6",
      "severity": "presentation_defect",
      "scope": "world/lighting views including 04-179 and 07-060..179",
      "finding": "Village views show harsh cream highlights, broadly mottled terrain, sparse small trees and a repeated fence field with limited atmospheric depth. Bright surface patches and black shadow areas lack the softer lighting/material hierarchy of the restored meadow board. This is a judgment of the supplied views only.",
      "examples": [
        "04-179.png",
        "07-060.png",
        "07-179.png"
      ]
    }
  ],
