{
  "schema": "tetherbound.code-blind.visual-review.v1",
  "review_id": "camera-bf9-blind-r1",
  "date": "2026-09-30",
  "criterion": "F21#4: Fight camera keeps both actors framed without overlap for small, normal and giant bodies (catalog P2-062/P2-092 class); code-blind judge PASS on a size matrix.",
  "scope": {
    "input": "Only the 54 user-named original native PNGs and four restored reference images were used as visual evidence.",
    "blindness": "No production source, solver, numerical producer pass/fail verdicts or author self-report were read for this visual task. Pair mapping and moment labels come from the user's instruction. Visible HUD text is part of original pixels.",
    "session_limit": "This is the reused session requested by the user, not a fresh-context reviewer. Earlier unrelated village/source work existed in its context. No Fight-camera production-source rationale was consulted or used to decide these visual findings.",
    "actors": "The two size-matrix combat creatures are the primary actors. Human and other creatures are recorded separately as scene presentation/occlusion findings. Screen left/right can change; labels refer to visible position in each image.",
    "method": "All 54 actual originals individually opened through view_image with original detail. No sheets, crops, recoloring, fabricated images, image regeneration or scene render used. Borderline contacts were re-viewed in five original images.",
    "rule": "Any failed supplied frame fails its pair and the matrix. Camera/readability observations and the requested broader craft judgment are explicitly recorded; a limited camera PASS is not a full-quality or acceptance PASS.",
    "limits": [
      "Six still moments per pair only; unobserved frames and transitions are unjudged.",
      "No motion, frame-rate, animation continuity, camera stability over time, earned gameplay path or co-op claims.",
      "PNG pixels cannot authenticate the engine version, actor resource IDs/catalog class, camera mode implementation, live control state or provenance beyond the user-supplied original files.",
      "Pose-caused self-hiding of a face is reported without automatically calling it camera clipping; HUD coverage of antlers, tails, feet or body is a strict readability failure.",
      "No engine, import, render, export, GPU work, Git access/mutation, tests, production changes, board/STATE edits or external messages performed.",
      "ROOT independently decides literal acceptance, packaging and authority; this review grants no acceptance credit."
    ]
  },
