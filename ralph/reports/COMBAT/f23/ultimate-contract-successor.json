  "mastery": {
    "_comment": "F23 prototype: character-scope per-creature mastery from host-resolved landed hits. Uses saturate at rank5; durable per-move event identities prevent snapshot/rejoin replay. Never changes move timing, range, cone or resource cost.",
    "rank_thresholds": [
      0,
      25,
      75,
      150,
      300
    ],
    "damage_per_rank": 0.05,
    "max_known_moves": 128
  },
  "presentation_contract": {
    "duration_seconds": 2.4,
    "windup_seconds": 0.6,
    "recovery_seconds": 1.8,
    "host_action_identity": "action_id + character_id/creature_uid/encounter_id/generation, frozen by host acceptance",
    "visual_seed": "No extra seed field exists. Deterministic visual randomness may derive from the SAME host action_id; it cannot mint damage/receipt identity.",
    "arrival": "Same host accepted release/arrival owns actual damage/effect commit. Presentation is disposable; no animation callback can hit, spend or award.",
    "cancellation": "Canonical producer must expire/cancel same accepted action on actor death, generation/body replacement, encounter end or host refusal. Visual owner tears down on that authority lifetime; no second registry.",
    "rank_growth": "Frozen rank 1..5; +5% damage per additional rank; breakthrough signature damage +10% per completed ordinal; presentation count base+rank-1+breakthrough_count, size base*rankMultiplier*(1+0.05*breakthrough_count), impact base*rankMultiplier.",
    "fixed": "No mastery/tier changes to geometry/timing/resource costs; named target cap20%maxHP; fullmeter100 spendonce; signature earns0meter.",
    "f35_scope": "ultimates.json may index/describe canonical IDs and VFX assets only; no duplicate effect/stat/damage/slot/save authority.",
    "producer_route": "F25 launch consumes full frozen action + trusted current_actor/action/generation + finite host-clock travel_seconds and actual anchors; old shared9479 vfx-only call is an unintegrated proposal.",
    "gear_gain": "Same accepted action may hold gear_ultimate_gain_multiplier from canonical F33; host copies gear.json limits cap1.52 into meter_config.gear_gain_multiplier_cap. Default1, finite bounds; actual debit/receipt only."
  },
