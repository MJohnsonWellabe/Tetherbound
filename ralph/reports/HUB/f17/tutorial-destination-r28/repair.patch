+func test_tutorial_target_matches_road_destination_instead_of_farmhouse_nearest() -> void:
+	var anchor := Vector3(30, 0.9, -40)
+	var candidates := [
+		{"species": "bramblebun", "position": Vector3(-7.131816, -0.735385, 64.318047), "visible": true, "alive": true},
+		{"species": "bramblebun", "position": Vector3(38.824909, -1.001545, -48.624557), "visible": true, "alive": true},
+		{"species": "bramblebun", "position": Vector3(29, 0, -36), "visible": true, "alive": true}]
+	assert_eq(OPENING_DRIVE.practice_wild_index(candidates, "bramblebun", anchor), 2)
+	# The failed native target is closest to the farmhouse, so changing the
+	# selection origin is material even though travel/engagement stay real.
+	assert_eq(OPENING_DRIVE.practice_wild_index(candidates, "bramblebun", Vector3(8.3, 0.9, 14)), 0)
+	candidates.remove_at(2)
+	assert_eq(OPENING_DRIVE.practice_wild_index(candidates, "bramblebun", anchor), 1,
+		"the farther meadow body remains eligible; selection is not a shorter travel requirement")
+
+
+func test_tutorial_destination_selection_requires_live_visible_matching_body() -> void:
+	var anchor := Vector3(30, 0.9, -40)
+	var candidates := [
+		{"species": "mudsnout", "position": anchor, "visible": true, "alive": true},
+		{"species": "bramblebun", "position": anchor, "visible": false, "alive": true},
+		{"species": "bramblebun", "position": anchor, "visible": true, "alive": false},
+		{"species": "bramblebun", "position": Vector3(36, 0, -42), "visible": true, "alive": true}]
+	assert_eq(OPENING_DRIVE.practice_wild_index(candidates, "bramblebun", anchor), 3)
+	candidates.remove_at(3)
+	assert_eq(OPENING_DRIVE.practice_wild_index(candidates, "bramblebun", anchor), -1)
+
+
+func test_tutorial_destination_selection_refuses_missing_or_nonfinite_evidence() -> void:
+	var anchor := Vector3(30, 0.9, -40)
+	var candidates := [null, {}, {"species": "bramblebun", "position": [30, -40], "visible": true, "alive": true},
+		{"species": "bramblebun", "position": Vector3.INF, "visible": true, "alive": true}]
+	assert_eq(OPENING_DRIVE.practice_wild_index(candidates, "bramblebun", anchor), -1)
+	assert_eq(OPENING_DRIVE.practice_wild_index([], "bramblebun", anchor), -1)
+	assert_eq(OPENING_DRIVE.practice_wild_index([], "", anchor), -1)
+	assert_eq(OPENING_DRIVE.practice_wild_index([], "bramblebun", Vector3.INF), -1)
