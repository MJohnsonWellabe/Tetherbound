+## A coincident transition can own the arrival road's redundant 2 m hub.
+## Prove containment and exact height from actual built geometry before
+## omitting ONLY that fan from collision. All outer strips/skirt stay solid.
+func _transition_covers_arrival_hub(route: Node3D, crown: Vector3, inner: Array) -> bool:
+	var pad := get_node_or_null(^"RealmTransitionLedges/CloudreachArrivalFromMeadows") as Node3D
+	if pad == null or not pad.has_meta(&"transition_crown_polygon"): return false
+	var mesh := pad.get_node_or_null(^"StratifiedCliffBody") as MeshInstance3D
+	var body := pad.get_node_or_null(^"Collision") as StaticBody3D
+	if mesh == null or mesh.mesh == null or body == null or body.get_child_count() != 1: return false
+	var shape_node := body.get_child(0) as CollisionShape3D
+	if shape_node == null or shape_node.disabled or not shape_node.shape is ConcavePolygonShape3D: return false
+	var top: PackedVector3Array = mesh.mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]
+	var faces := (shape_node.shape as ConcavePolygonShape3D).get_faces()
+	if top.is_empty() or faces.size() < top.size() or inner.size() < 3: return false
+	var at := route.to_global(crown)
+	if at.x != pad.global_position.x or at.z != pad.global_position.z: return false
+	for i in top.size():
+		if faces[i] != top[i] or pad.to_global(top[i]).y != at.y: return false
+	var boundary: PackedVector2Array = pad.get_meta(&"transition_crown_polygon")
+	var polygon := PackedVector2Array()
+	for point: Vector2 in boundary:
+		var world_point := pad.to_global(Vector3(point.x, top[0].y, point.y))
+		polygon.append(Vector2(world_point.x, world_point.z))
+	var hub := PackedVector2Array()
+	for point: Vector3 in inner:
+		var world_point := route.to_global(point + Vector3.UP * 0.03)
+		if world_point.y != at.y: return false
+		hub.append(Vector2(world_point.x, world_point.z))
+	return Geometry2D.clip_polygons(hub, polygon).is_empty()
+
