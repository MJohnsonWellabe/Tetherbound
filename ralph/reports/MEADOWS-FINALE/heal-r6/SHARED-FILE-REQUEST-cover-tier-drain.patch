+// DRAINED GROUND (F05#7, meadow_healing.gd through grass_field.gd::set_drain).
+// The same discs the blade tier thins and browns: a cover item inside is
+// culled by hash in proportion `d * drain_thin` (flowers: none bloom on the
+// drained ground; bushes: fewer).
+// d = strength * (1 - smoothstep(inner, r, dist)) * drain_amount; zero discs
+// or zero amount skips the loop outright, so the tier is untouched.
+uniform vec3 drain_disc[32];
+uniform vec2 drain_shape[32];
+uniform int drain_count = 0;
+uniform float drain_amount = 0.0;
+uniform float drain_thin = 0.9;
+
+float drain_at(vec2 world_xz) {
+	if (drain_count <= 0 || drain_amount <= 0.0001) {
+		return 0.0;
+	}
+	float d = 0.0;
+	for (int i = 0; i < drain_count; i++) {
+		float dist = length(world_xz - drain_disc[i].xy);
+		float r = drain_disc[i].z;
+		if (dist < r) {
+			float inner = min(drain_shape[i].x, r - 0.001);
+			d = max(d, drain_shape[i].y * (1.0 - smoothstep(inner, r, dist)));
+		}
+	}
+	return clamp(d, 0.0, 1.0) * drain_amount;
+}
