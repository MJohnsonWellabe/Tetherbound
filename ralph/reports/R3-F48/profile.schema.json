{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F48 reviewed actual-input evidence profile; never an earned-progression adapter",
  "type": "object",
  "required": [
    "provenance",
    "saves",
    "routes",
    "outcomes"
  ],
  "additionalProperties": false,
  "properties": {
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "saves": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "routes": {
      "type": "object",
      "description": "loop: hub_N,craft_N,portal_N,master_N,feast_cook_N,feast_N,relic_N plus boss routes. boss: boss_prepare_N,boss_start,boss_join_N,boss_fight. behind: host_unlock_tidewake,host_enter_tidewake,behind_enter_tidewake. transactions: TRANSACTION_prepare,TRANSACTION_commit,TRANSACTION_reopen. Reopen restores ordinary controls only for first input after before_input crash; committed cases use actual admission journal replay, never a fresh transaction. N is actual peer index.",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1000,
        "items": {
          "type": "object",
          "required": [
            "action",
            "args"
          ],
          "additionalProperties": false,
          "properties": {
            "action": {
              "enum": [
                "press",
                "stick",
                "move_to",
                "wait",
                "f48_button",
                "f48_build_cell",
                "f48_choice"
              ]
            },
            "args": {
              "type": "object"
            }
          }
        }
      }
    },
    "outcomes": {
      "type": "object",
      "description": "Independently reviewed feast_N/release_N/essence_spend_N expectations. Cannot relax fixed counts/costs/receipts. Feast requires creature uid/unchanged level/exact breakthroughs. Release requires original released_uid and exact essence delta. Essence spend requires exact delta and creature uid/exact new level/unchanged breakthroughs.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "equals": {
            "type": "object"
          },
          "item_delta": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "integer"
            }
          },
          "released_uid": {
            "type": "string",
            "minLength": 1
          },
          "creature": {
            "type": "object",
            "required": [
              "uid",
              "level",
              "breakthroughs"
            ],
            "additionalProperties": false,
            "properties": {
              "uid": {
                "type": "string",
                "minLength": 1
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
              },
              "breakthroughs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 6
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "suite_profiles": {
      "type": "object",
      "description": "Immutable original producer snapshot selections; no proof/cut/configuration replacement.",
      "propertyNames": {
        "enum": [
          "loop",
          "behind",
          "boss_four"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/actual_start"
      }
    },
    "transaction_profiles": {
      "type": "object",
      "description": "Immutable original producer snapshot selections; no proof/cut/configuration replacement.",
      "propertyNames": {
        "enum": [
          "craft",
          "release",
          "feast",
          "key",
          "relic",
          "essence_spend"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/actual_start"
      }
    },
    "configuration_scope": {
      "enum": [
        "bootstrap",
        "full"
      ]
    },
    "test_configuration": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "file",
          "sha256",
          "source_sha256",
          "overlay_file",
          "enabled_fields"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "enum": [
              "res://data/config/stations.json",
              "res://data/config/essence.json",
              "res://data/config/traits.json",
              "res://data/config/multiplayer.json",
              "res://data/config/hud.json",
              "res://data/config/alpha_respawns.json"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "overlay_file": {
            "type": "string",
            "minLength": 1
          },
          "enabled_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "actual_start": {
      "type": "object",
      "required": [
        "provenance",
        "saves",
        "routes",
        "outcomes"
      ],
      "additionalProperties": false,
      "properties": {
        "provenance": {
          "$ref": "#/properties/provenance"
        },
        "saves": {
          "$ref": "#/properties/saves"
        },
        "routes": {
          "$ref": "#/properties/routes"
        },
        "outcomes": {
          "$ref": "#/properties/outcomes"
        }
      }
    }
  }
}
