index 6012a234..abd1039d 100644
--- a/tools/net/peer_runner.gd
+++ b/tools/net/peer_runner.gd
@@ -1908,7 +1908,13 @@ func _step_production_join(args: Dictionary) -> Dictionary:
 	if returning_route:
 		title.call("_join_via", ip, port)
 		if pick_saved:
-			var pressed := _press_saved_character(title, wanted_id)
+			# The title may already have adopted this machine's saved character
+			# (then `_join_via` goes straight to `_begin_join`, no picker): that
+			# is the returning route itself, so no press is needed. Only a picker
+			# that is up must offer `character_id`.
+			var adopted := local != null and str((local as RefCounted).get("character_id")) == wanted_id \
+				and game.get_node_or_null(^"JoinDriver") != null
+			var pressed := "" if adopted else _press_saved_character(title, wanted_id)
 			if not pressed.is_empty():
 				return {"verdict": "FAIL", "detail": pressed}
 	else:
