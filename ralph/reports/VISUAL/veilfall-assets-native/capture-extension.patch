@@ -78,6 +78,34 @@ func _run() -> void:
 		root.get_viewport().get_texture().get_image().save_png(path)
 		log.append({"stand": stand[0], "player": [at.x, at.y, at.z], "yaw_deg": stand[2], "pitch_deg": stand[3]})
 		print("VEILFALL INTERIOR %s" % path)
