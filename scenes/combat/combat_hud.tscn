; Overlay host for the once-off "energy full" pulse — a bare Control sized to
; the bar so `combat_hud.gd` can lay a ColorRect flash directly over it
; without fighting the ProgressBar's own drawing.
[node name="EnergyHost" type="Control" parent="Root/AllyPanel/AllyVBox/EnergyRow"]
mouse_filter = 2
custom_minimum_size = Vector2(300, 8)
size_flags_vertical = 4

[node name="Energy" type="ProgressBar" parent="Root/AllyPanel/AllyVBox/EnergyRow/EnergyHost"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
max_value = 100.0
value = 0.0
show_percentage = false

