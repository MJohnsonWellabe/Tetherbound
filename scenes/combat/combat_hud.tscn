[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/combat_hud.gd" id="1_hud"]

; Combat HUD, rebuilt to the owner's Palworld-inspired spec (`docs/*` §9) plus
; D32's mid-combat switching UI. Static shape lives here (panels, bars, cell
; scaffolding); every colour that has to change with the fight — health
; fraction, type tag, cell ready/dimmed state, the switch selector's rows —
; is applied in `combat_hud.gd`, same split the pre-rebuild file already used
; for its two health bars.
;
; Three fixed regions, none of which overlap at 1920x1080: the enemy plate
; top-center, the controlled-pal block + party strip lower-left, and the
; 2x2 move grid + orb count lower-right. The centre strip along the bottom
; (between the pal block and the grid) is deliberately empty screen — that is
; where Prompt, the aim row and the catch-resolution row live, one at a time,
; never more than one of the three visible together.
;
; PanelContainers carry no stylebox here — `UITokens.panel_box()` /
; `slot_box()` / a local quiet-panel box are applied in code so a single
; token change updates every panel at once, the same reasoning
; `ui_tokens.gd`'s own header gives for existing as a module at all.

[node name="CombatHUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Root" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

; --- Enemy plate: top-center -------------------------------------------------

[node name="EnemyPanel" type="PanelContainer" parent="Root"]
mouse_filter = 2
anchor_left = 0.5
anchor_right = 0.5
offset_left = -280.0
offset_right = 280.0
offset_top = 32.0
offset_bottom = 224.0
grow_horizontal = 2

[node name="EnemyVBox" type="VBoxContainer" parent="Root/EnemyPanel"]
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Eyebrow" type="Label" parent="Root/EnemyPanel/EnemyVBox"]
horizontal_alignment = 1
theme_override_font_sizes/font_size = 23
theme_override_colors/font_color = Color(0.722, 0.773, 0.769, 1)
text = "LEVEL —"

[node name="Name" type="Label" parent="Root/EnemyPanel/EnemyVBox"]
horizontal_alignment = 1
theme_override_font_sizes/font_size = 42
theme_override_colors/font_color = Color(0.949, 0.961, 0.949, 1)
text = "—"

[node name="TypeTag" type="Label" parent="Root/EnemyPanel/EnemyVBox"]
