[gd_scene load_steps=2 format=3]

; The conversation box. Layout only — colours, the panel background and the
; text outlining are applied in scripts/ui/dialogue_panel.gd, so a restyle is
; one file rather than a scene diff nobody can read.
;
; Sized for the Ally: the project authors at 1920x1080 and stretches
; canvas_items, so these are real handheld pixels.

[ext_resource type="Script" path="res://scripts/ui/dialogue_panel.gd" id="1_panel"]

[node name="DialoguePanel" type="CanvasLayer"]
; Above the playground HUD and the combat HUD, which are both at the default 0.
; A conversation is modal; nothing should draw over it.
layer = 5
script = ExtResource("1_panel")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="Box" type="PanelContainer" parent="Root"]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.11
anchor_top = 1.0
anchor_right = 0.89
anchor_bottom = 1.0
offset_top = -308.0
offset_bottom = -56.0
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="Root/Box"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 20

[node name="Row" type="HBoxContainer" parent="Root/Box/Margin"]
layout_mode = 2
theme_override_constants/separation = 24

; 200px square. Big enough that the face reads at handheld pixel density, small
; enough that the line of text still gets most of the box.
[node name="Portrait" type="TextureRect" parent="Root/Box/Margin/Row"]
custom_minimum_size = Vector2(200, 200)
layout_mode = 2
size_flags_vertical = 4
expand_mode = 1
stretch_mode = 5

[node name="Text" type="VBoxContainer" parent="Root/Box/Margin/Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Speaker" type="Label" parent="Root/Box/Margin/Row/Text"]
layout_mode = 2
theme_override_font_sizes/font_size = 30

; Wrapped, and given the vertical slack, so a long line grows downward inside a
; fixed box instead of running off the right-hand side.
[node name="Body" type="Label" parent="Root/Box/Margin/Row/Text"]
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 34
autowrap_mode = 3
vertical_alignment = 1

[node name="Hint" type="RichTextLabel" parent="Root/Box/Margin/Row/Text"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 24
horizontal_alignment = 2
bbcode_enabled = true
fit_content = true
scroll_active = false
shortcut_keys_enabled = false
