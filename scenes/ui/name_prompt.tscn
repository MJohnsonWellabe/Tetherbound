[gd_scene load_steps=2 format=3]

; The naming prompt. Shell only — the on-screen keyboard's rows are built in
; scripts/ui/name_prompt.gd from name_entry.gd's layout, so the grid and the
; thing that navigates it cannot disagree about how many cells there are.

[ext_resource type="Script" path="res://scripts/ui/name_prompt.gd" id="1_name"]

[node name="NamePrompt" type="CanvasLayer"]
; Above the dialogue panel. Naming is the one modal thing in the sequence that
; a conversation can be underneath.
layer = 6
script = ExtResource("1_name")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

; The world is still rendering behind this and the meadow is bright. Without
; the dim, white text on a grid of small plates sits on sunlit grass.
[node name="Backdrop" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.02, 0.03, 0.04, 0.72)
mouse_filter = 2

[node name="Box" type="PanelContainer" parent="Root"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -420.0
offset_top = -330.0
offset_right = 420.0
offset_bottom = 330.0
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="Root/Box"]
layout_mode = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 26
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 26

[node name="Column" type="VBoxContainer" parent="Root/Box/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Root/Box/Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
horizontal_alignment = 1

; What the player has typed so far, big. This is the whole point of the screen.
[node name="Entry" type="Label" parent="Root/Box/Margin/Column"]
layout_mode = 2
theme_override_font_sizes/font_size = 52
horizontal_alignment = 1

[node name="Keys" type="VBoxContainer" parent="Root/Box/Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 6

[node name="Hint" type="RichTextLabel" parent="Root/Box/Margin/Column"]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 24
horizontal_alignment = 1
bbcode_enabled = true
fit_content = true
scroll_active = false
shortcut_keys_enabled = false
