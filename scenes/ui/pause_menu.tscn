[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1_pause"]

; The pause menu — what the Start button opens. Only what makes this screen
; different from the others is here; the panel, title, rule and footer come from
; `screen.gd`, which reparents everything below into its content area.
;
; RowTemplate is the one authored row. `pause_menu.gd` removes it and duplicates
; it once per entry, so the row layout is a thing you change once.
;
; The centre column is capped at 720px: six short verbs stretched across a full
; 1560px panel read as six ruled lines on a page, not as a menu.
;
; Anchored, never positioned in absolute pixels: the project authors at
; 1920x1080 and stretches canvas_items, so this has to survive a desktop window.

[node name="PauseMenu" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("1_pause")
title = "Paused"
open_action = &"pause_menu"

[node name="Body" type="VBoxContainer" parent="."]
size_flags_vertical = 3
theme_override_constants/separation = 20

[node name="List" type="VBoxContainer" parent="Body"]
custom_minimum_size = Vector2(720, 0)
size_flags_horizontal = 4
size_flags_vertical = 3
theme_override_constants/separation = 12

[node name="RowTemplate" type="PanelContainer" parent="Body/List"]
visible = false
custom_minimum_size = Vector2(720, 78)

[node name="Pad" type="MarginContainer" parent="Body/List/RowTemplate"]
theme_override_constants/margin_left = 28
theme_override_constants/margin_right = 28
theme_override_constants/margin_top = 10
theme_override_constants/margin_bottom = 10

[node name="Label" type="Label" parent="Body/List/RowTemplate/Pad"]
theme_override_font_sizes/font_size = 34
text = "Entry"

[node name="Footnote" type="RichTextLabel" parent="Body"]
custom_minimum_size = Vector2(0, 44)
bbcode_enabled = true
fit_content = true
scroll_active = false
mouse_filter = 2
theme_override_font_sizes/normal_font_size = 24
