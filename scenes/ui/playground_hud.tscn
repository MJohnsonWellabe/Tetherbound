; HUD-LAYOUT: 28 -> 36. A blind critic measured this line -- "Call out
; Biscuit", the single most important teaching line on this HUD (it is the
; only place the player is told the button that puts a creature into their
; hands) -- at ~15px physical cap height on the Ally's real 1280x800 window,
; just under the same ~16px arm's-length floor `HUD_READABLE_FONT_SIZE`
; (`playground_hud.gd`) already raised every other label on this HUD to
; clear.
; HUD-SCALE: 36 -> 32, `playground_hud.gd::HUD_SENTENCE_FONT_SIZE`. This line
; is the one piece of HUD text that is genuinely a sentence, so it keeps the
; larger of the two tiers; the note above is right that it must not be the
; smallest thing on screen, and it still is not.
[node name="Prompt" type="RichTextLabel" parent="Root/BottomDock"]
custom_minimum_size = Vector2(640, 0)
size_flags_horizontal = 4
mouse_filter = 2
theme_override_font_sizes/normal_font_size = 32
horizontal_alignment = 1
bbcode_enabled = true
fit_content = true
scroll_active = false
shortcut_keys_enabled = false
text = ""

[node name="DebugReadout" type="Label" parent="Root"]
visible = false
offset_left = 32.0
offset_top = 120.0
offset_right = 900.0
offset_bottom = 620.0
mouse_filter = 2
theme_override_font_sizes/font_size = 22
text = "waiting for player"
