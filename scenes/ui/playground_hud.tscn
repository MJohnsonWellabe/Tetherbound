[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/playground_hud.gd" id="1_hud"]

[node name="PlaygroundHUD" type="CanvasLayer"]
script = ExtResource("1_hud")
player_path = NodePath("../Player")
arbiter_path = NodePath("../InteractionArbiter")

; mouse_filter = 2 is MOUSE_FILTER_IGNORE, and it is load-bearing rather than
; cosmetic. A plain Control defaults to MOUSE_FILTER_STOP, and this one is
; full-rect over the whole viewport during ordinary play — so it consumed every
; InputEventMouseMotion during GUI input handling, which runs BEFORE
; _unhandled_input. camera_rig.gd accumulates look in _unhandled_input, so the
; camera never received a single mouse delta and mouse look was dead from the
; first frame, silently, with no error anywhere.
;
; combat_hud.tscn, dialogue_panel.tscn and name_prompt.tscn all already set
; this. game_menu.tscn sets MOUSE_FILTER_STOP deliberately — a pause menu
; SHOULD take the mouse.
;
; tests/smoke_mouse_look.gd fails if this line is removed. Everything the
; Palworld-layout rebuild adds under Root is built in code by
; playground_hud.gd's _ready(), not authored here — see that file's header —
; specifically so every new Control inherits MOUSE_FILTER_IGNORE from the one
; place that sets it, rather than needing this comment repeated at each node.
[node name="Root" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

; Shifted up 46px total from its original authoring (-254/-144 -> -280/-170
; -> -300/-190). The first 26px (offset_top/offset_bottom -254/-144 ->
; -280/-170) fixed an owner playtest report -- Root/Prompt below (offset_top
; -140) sat only 4px under this panel's original bottom edge (-144), reading
; as a single crowded block with "Call out Biscuit" jammed against the
; hotbar slots.
;
; OF17: the owner reported the SAME overlap again after that fix, still
; described as the recall/put-away hint rendering "on top of" the hotbar.
; Real root cause, found by measuring both Controls' live get_global_rect()
; instead of trusting the authored offsets: this panel is NOT a fixed-height
; box. Godot never lets a Control's actual size fall below its own computed
; minimum size, offsets or no offsets -- and Margin/Layout/Message
; (`_show_hotbar_message()`: "repaired, free.", a heal readout, every
; hotbar-slot response) is `visible = false` most of the time but joins the
; VBoxContainer as a real row the instant it shows, measured growing this
; panel's actual height by 30px. The first fix's 30px static gap was tuned
; against this panel's QUIET height; the moment a player pressed a hotbar
; slot for real, that growth ate the entire gap and this panel's bottom edge
; crossed into Root/Prompt below it -- confirmed by re-running
; tests/smoke_playground.gd's `_the_recall_prompt_never_overlaps_the_hotbar`
; (added alongside this fix) against the pre-fix offsets with the message
; row showing: real engine rects, `intersects=true`, not hand math. This
; pass widens the margin another 20px so the 50px static gap survives the
; message row's 30px growth with real clearance left, instead of trusting a
; pixel count tuned against one quiet screenshot. Moving the whole panel up
; again preserves its own height and every slot's internal layout untouched,
; the same technique the first fix used.
; OW8. Third report of the same overlap, after two fixes that both moved
; offsets: the recall/put-away prompt rendering on top of the hotbar. Both
; earlier passes tuned a static gap (26px, then another 20px) against this
; panel's QUIET height, and both were defeated the same way -- Margin/Layout/
; Message is `visible = false` most of the time and joins the VBoxContainer as
; a real row the instant a hotbar slot answers, measured growing the panel 30px
; and eating the gap.
;
; A third number would have been a third guess. Instead both controls now live
; in this one bottom-anchored container, stacked. A VBoxContainer lays its
; children out in sequence with a fixed separation, so neither can be
; positioned into the other AT ALL -- the hotbar growing a message row pushes
; the prompt, and a prompt that wraps to three lines pushes nothing into the
; hotbar. There is no arithmetic left to get wrong, which is why
; `playground_hud.gd::_reflow_prompt` and its PROMPT_GAP/PROMPT_HEIGHT
; constants are gone with this.
;
; grow_vertical = 0 (BEGIN) with alignment = 2 (END): the stack hugs the
; bottom edge and grows UPWARD into empty screen, rather than downward off it.
;
; Gate A handheld hierarchy: this dock spans the authored safe width so its
; two children can use different horizontal zones while retaining the shared
; VBox relationship above. The contextual prompt keeps its authored 800px
; measure and remains centred. The hotbar shrinks to its content at the right
; edge, keeping the trainer/camera focus lane clear instead of covering the
; character's torso at the normal third-person framing.
[node name="BottomDock" type="VBoxContainer" parent="Root"]
anchor_right = 1.0
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 56.0
offset_top = -340.0
offset_right = -56.0
offset_bottom = -96.0
grow_vertical = 0
alignment = 2
mouse_filter = 2
theme_override_constants/separation = 30

; SHRINK_END so the panel keeps its own content width in the right safe zone.
; This separates persistent item shortcuts from the centred contextual verb;
; it does not change either action layer or any of their bindings.
[node name="HotbarPanel" type="PanelContainer" parent="Root/BottomDock"]
custom_minimum_size = Vector2(524, 0)
size_flags_horizontal = 8
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="Root/BottomDock/HotbarPanel"]
mouse_filter = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 10

[node name="Layout" type="VBoxContainer" parent="Root/BottomDock/HotbarPanel/Margin"]
mouse_filter = 2
theme_override_constants/separation = 4

[node name="Slots" type="HBoxContainer" parent="Root/BottomDock/HotbarPanel/Margin/Layout"]
mouse_filter = 2
theme_override_constants/separation = 14
alignment = 1

; HUD-POPUP task 3: 13 -> 36 on every Slot Label's own base font size below.
; The visible item count already overrides its own size inline
; (`playground_hud.gd::HOTBAR_COUNT_FONT_SIZE`), so this default only ever
; mattered for text nothing else sizes -- `input_glyph.gd::icon()`'s bracket
; fallback ("[RB]", "[LB]", "[START]") for an action with no vendored glyph
; PNG for the current device, which inherits whatever this base size is
; rather than the `px` argument the image path uses. A blind critic measured
; that fallback text at ~6-10 physical px, "the pills read as blank white
; lozenges" -- 13 authored is ~6.1 physical cap-height px at the Ally's real
; scale (13 * 0.667 * 0.7), matching the low end of that range almost
; exactly. This does not touch which glyph a legend/hotbar row shows or
; `input_glyph.gd` itself (owned by `ralph/DPAD-COLLISION`) -- only the size
; text renders at when a glyph image is not the thing being drawn.
; HUD-SCALE (owner playtest 2026-08-28, the SECOND "the hud on screen is way
; too big"). Slot 112x180 -> 88x132, panel floor 660 -> 524, and the base font
; 36 -> 26. GF-B-005's note below is still correct about the ORDER of the three
; lines and about width being the tight axis; what it could not know is that
; every size it was fitting to had been inflated 1.5x by a 0.667 content scale
; the owner's 1920x1080 device does not have -- see `scripts/ui/hud_scale.gd`.
; Three lines at 44 (icon) + 26 (badge) + 26 (count) plus leading fit 132, the
; same way three lines at 64 + 36 + 36 fitted 180. Nothing is dropped and the
; item still leads the badge by the same 1.7x.
;
; Slot height 152 -> 180 on all five (GF-B-005). The slot now draws the ITEM
; ICON at `playground_hud.gd::HOTBAR_ICON_PX` (64, up from an inlined 28) on the
; top line, with the binding badge and the count under it -- the quick-bar
; photographed as five near-identical d-pad badges over 28px item art, so the
; badge and the item swapped places and the item grew. Three stacked lines at
; 64 + 36 + 36 plus leading do not fit 152. Width is still the axis with nothing
; to give, for the reason the original note below gives; `smoke_prompt_hotbar_dock.gd`
; measured 172px of clearance between this dock and the contextual prompt, which
; is what this 28px pays out of.
;
; The original note, still the reason the slot is short and tall rather than wide:
; Slot height 104 -> 152 on all five. A tool slot used to draw its item icon and
; its durability on ONE line -- a 28px inline icon plus "40/40" at
; HOTBAR_COUNT_FONT_SIZE (36) needs ~119px, against ~104px of inner width -- and
; with `scroll_active = false` and `fit_content = false` the overflow was simply
; cut, which a blind critic saw as the count clipped to half-glyphs in every
; frame the quickbar appeared in. The icon now sits on its own line above the
; count (`playground_hud.gd::_update_hotbar_and_message`), which needs the
; height instead of the width. Width is the one axis that had nothing to give:
; the dock is right-aligned and `smoke_prompt_hotbar_dock.gd` fails the build if
; it reaches the central 440px trainer/camera focus lane, which leaves the panel
; about 8px of slack at its current width. Height is free -- the same test
; measures 172px of clearance between this dock and the contextual prompt.
[node name="Slot1" type="PanelContainer" parent="Root/BottomDock/HotbarPanel/Margin/Layout/Slots"]
custom_minimum_size = Vector2(88, 132)
mouse_filter = 2

[node name="Label" type="RichTextLabel" parent="Root/BottomDock/HotbarPanel/Margin/Layout/Slots/Slot1"]
mouse_filter = 2
theme_override_font_sizes/normal_font_size = 26
bbcode_enabled = true
fit_content = false
scroll_active = false
shortcut_keys_enabled = false
horizontal_alignment = 1
vertical_alignment = 1
text = ""

