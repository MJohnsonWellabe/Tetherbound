[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/ui/screen_stack.gd" id="1_stack"]
[ext_resource type="PackedScene" path="res://scenes/ui/party_screen.tscn" id="2_party"]
[ext_resource type="PackedScene" path="res://scenes/ui/rename_screen.tscn" id="3_rename"]
[ext_resource type="PackedScene" path="res://scenes/ui/release_screen.tscn" id="4_release"]
[ext_resource type="PackedScene" path="res://scenes/ui/farewell_screen.tscn" id="5_farewell"]

; The menu layer, ready to drop into a world scene. Set `player_path` at the
; trainer and `party_screen_path`'s target — the PartyScreen below — at the party
; node, and pressing Y / I opens the party.
;
; The party screen is a CHILD rather than something instanced when the button is
; pressed. Instancing a screen at the moment it opens is a hitch in the one frame
; the player is watching for a response; `encounter_director` keeps the ally's
; body in the world for the same reason. Screens authored here start hidden —
; `screen_stack.gd` hides them on ready, so a menu wired into the world cannot
; make the game boot into a menu.
;
; `process_mode = 3` is PROCESS_MODE_ALWAYS. The stack pauses the tree while a
; screen is open and has to keep running through the pause it caused; the script
; sets this too, so an instance built in code cannot come up frozen.
;
; Layer 10 puts menus over the combat HUD and the build strip, which are both on
; the default layer. A party menu drawn under a health bar is not a menu.

[node name="ScreenStack" type="CanvasLayer"]
process_mode = 3
layer = 10
script = ExtResource("1_stack")
toggle_action = &"party_menu"
toggle_screen_path = NodePath("PartyScreen")

[node name="PartyScreen" parent="." instance=ExtResource("2_party")]
visible = false
rename_screen_path = NodePath("../RenameScreen")

; The rename screen, pushed ON TOP of the party list rather than replacing it.
; That is the stack's whole reason for existing — `screen_stack.gd`: the screen
; below stays visible and dims, so "this is about that pal" is something the
; player can see rather than something they have to remember.
;
; It must stay AFTER PartyScreen in this file. `meadows_playground.tscn` reaches
; in with `[node name="PartyScreen" parent="ScreenStack" index="0"]` to set
; `party_path`, and that index is positional; a screen inserted above would
; silently move the party wiring onto the wrong node.
[node name="RenameScreen" parent="." instance=ExtResource("3_rename")]
visible = false

; The release ceremony. Two screens, and neither is opened by a button — nothing
; the player can press reaches them. `release_prompt.gd` pushes ReleaseScreen
; when a catch is refused because the party is full, which is the only way a
; sixth pal can exist (D13: there is no overflow storage anywhere).
;
; They live here, authored and hidden, for the reason at the top of this file:
; instancing a screen at the moment it opens is a hitch in the one frame the
; player is watching for a response — and this is the worst frame in the game to
; hitch, because the player has just caught something and does not yet know they
; are about to lose one.
;
; Both go AFTER PartyScreen and RenameScreen, and anything added later goes after
; these. `meadows_playground.tscn` reaches in with index="0" to set the party
; wiring, and that index is positional.
[node name="ReleaseScreen" parent="." instance=ExtResource("4_release")]
visible = false
farewell_screen_path = NodePath("../FarewellScreen")

; Pushed ON TOP of the six by ReleaseScreen itself, never opened directly, so it
; has no path back to anything — it only ever knows the one pal it is about.
[node name="FarewellScreen" parent="." instance=ExtResource("5_farewell")]
visible = false
