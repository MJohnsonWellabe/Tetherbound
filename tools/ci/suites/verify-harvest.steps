# CI-SPEED suite group (tools/ci/run_suite.py). Steps copied verbatim from
# the former ci.yml job; each step runs in order in one lane, with the
# lane's own XDG_DATA_HOME, RUNNER_TEMP and network namespace.
### job: verify-harvest
### seconds: 529
### job-timeout-minutes: 30

### step: Verify f27_altar_spend
### env SMOKE: f27_altar_spend
### env RETRIES: 1
set -uo pipefail
n=0
until [ "$n" -ge "$RETRIES" ]; do
  n=$((n + 1))
  echo "::group::smoke_${SMOKE}.gd attempt ${n}/${RETRIES}"
  if godot --headless --path . --script "tests/smoke_${SMOKE}.gd"; then
    echo "::endgroup::"
    exit 0
  fi
  echo "::endgroup::"
  echo "smoke_${SMOKE}.gd failed on attempt ${n}/${RETRIES}"
done
exit 1
### step: Verify release
### env SMOKE: release
### env RETRIES: 1
set -uo pipefail
n=0
until [ "$n" -ge "$RETRIES" ]; do
  n=$((n + 1))
  echo "::group::smoke_${SMOKE}.gd attempt ${n}/${RETRIES}"
  if godot --headless --path . --script "tests/smoke_${SMOKE}.gd"; then
    echo "::endgroup::"
    exit 0
  fi
  echo "::endgroup::"
  echo "smoke_${SMOKE}.gd failed on attempt ${n}/${RETRIES}"
done
exit 1
### step: Run the harvest regression checks
godot --headless --path . --script tests/run_tests.gd \
  -- --only=test_harvest.gd
