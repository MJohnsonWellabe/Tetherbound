### step: Verify art
### nightly
### env SMOKE: art
### env RETRIES: 1
set -uo pipefail
n=0
until [ "$n" -ge "$RETRIES" ]; do
  n=$((n + 1))
  echo "::group::smoke_${SMOKE}.gd attempt ${n}/${RETRIES}"
  if godot --headless --path . --script "tests/smoke_${SMOKE}.gd"; then
    echo "::endgroup::"
    exit 0
  fi
  echo "::endgroup::"
  echo "smoke_${SMOKE}.gd failed on attempt ${n}/${RETRIES}"
done
exit 1
### step: Verify F22 enemy patterns
set -euo pipefail
timeout 120s godot --headless --path . --script tests/smoke_f22_pattern_contract.gd
timeout 120s godot --headless --path . --script tests/smoke_f22_live_pattern_mount.gd
timeout 600s godot --headless --path . --fixed-fps 60 --script tests/smoke_f22_wild_reactions.gd
