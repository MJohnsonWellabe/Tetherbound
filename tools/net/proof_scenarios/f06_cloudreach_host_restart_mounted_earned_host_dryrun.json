    },
    {
      "peer": "all",
      "action": "expect_peers",
      "args": {
        "count": 2
      }
    },
    {
      "peer": 1,
      "action": "wait",
      "args": {
        "frames": 120
      }
    },
    {
      "peer": 1,
      "probe": "flying",
      "label": "REJOIN: flight state after the rejoin"
    },
    {
      "peer": 1,
      "action": "fly_land",
      "args": {
        "budget_frames": 1800
      },
