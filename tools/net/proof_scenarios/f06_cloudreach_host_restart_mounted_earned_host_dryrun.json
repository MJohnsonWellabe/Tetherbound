    {
      "peer": 1,
      "probe": "position",
      "label": "MOUNTED: the guest's mid-flight position"
    },
    {
      "peer": 0,
      "action": "restart_peer",
      "args": {
        "scene": "title"
      },
      "label": "RELOAD: the HOST's process ends and a fresh one starts at the title on the same disk (memory gone; only its saves survive)"
    },
    {
      "peer": 1,
      "action": "await_probe",
      "args": {
        "what": "input_context",
        "equals": "title",
        "budget_frames": 7200
      },
      "budget_frames": 8000,
      "label": "RELOAD: the guest, mid-flight when its host went down, is back at the title"
    },
    {
      "peer": 0,
