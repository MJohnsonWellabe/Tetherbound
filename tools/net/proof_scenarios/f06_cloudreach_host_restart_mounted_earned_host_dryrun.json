      "label": "CONTROL: the host saves (gate open) while the guest is mid-flight"
    },
    {
      "peer": 0,
      "action": "restart_peer",
      "args": {
        "scene": "title"
      },
      "label": "CONTROL: the HOST's process ends and a fresh one starts at the title on the same disk (memory gone; only its saves survive)"
    },
    {
      "peer": 1,
      "action": "await_probe",
      "args": {
        "what": "input_context",
        "equals": "title",
        "budget_frames": 7200
      },
      "budget_frames": 8000,
      "label": "CONTROL: the guest, mid-flight when its host went down, is back at the title"
    },
    {
      "peer": 0,
      "action": "title_load",
      "args": {
        "slot": 1
      },
      "budget_frames": 20000,
      "label": "CONTROL: the host loads the save it made while the guest was mounted (the title's own Load, which hosts)"
    },
    {
      "peer": 0,
      "action": "assert",
      "args": {
