      "action": "expect_peers",
      "args": {
        "count": 2
      }
    },
    {
      "peer": 1,
      "action": "wait",
      "args": {
        "frames": 120
      }
    },
    {
      "peer": 1,
      "probe": "flying",
      "label": "CONTROL: flight state after the rejoin"
    },
    {
      "peer": 1,
