    {
      "peer": 1,
      "action": "join"
    },
    {
      "peer": "all",
      "action": "expect_peers",
      "args": {
        "count": 2
      }
    },
    {
      "peer": 1,
      "action": "assert",
      "args": {
        "check": "flag_set",
        "flag": "cloudreach_upper_route_unlocked"
      },
      "expect": "FAIL",
      "label": "the joined guest reads the host's closed gate"
    },
    {
      "peer": 1,
      "action": "teleport",
      "args": {
        "at": [
          -104.0,
          473.0,
          2436.0
        ],
        "settle": 120
      },
      "label": "setup: the guest stands at the gate's legal (south) side"
    },
    {
      "peer": 1,
      "action": "party_uids",
      "args": {
        "remember": "five"
      },
      "label": "the guest's five creature UIDs before the flight"
    },
    {
      "peer": 1,
      "action": "fly_launch",
      "args": {
        "height": 10.0
      },
      "label": "MOUNTED: the guest launches on its galecrest at the gate's legal side"
    },
    {
      "peer": 1,
      "probe": "flying",
