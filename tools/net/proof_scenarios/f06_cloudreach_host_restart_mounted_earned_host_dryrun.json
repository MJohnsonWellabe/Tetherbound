{
  "name": "DRY RUN \u2014 does not count: F06#5 co-op half with the host on the earned C1 handoff",
  "claim": "DRY RUN \u2014 does not count. Readies the F06#5 co-op scenario for the earned flight checkpoint. The host loads the earned c1_arrival (tb/cloudreach-b 0883848d); the guest is still the fixture guest (fresh world, flag-unlocked Fly, granted party, teleport to the gate), which is why this cannot count. Same steps as f06_cloudreach_host_restart_mounted_save.json otherwise, with the LT build_cancel workaround removed now that Cloudreach's fix is merged.",
  "peers": 2,
  "scene": "title",
  "budget_s": 3600,
  "build_allowance_s": 300,
  "steps": [
    {
      "peer": 0,
      "action": "load_save",
      "args": {
        "from": "tests/fixtures/earned_saves/c1_arrival/save",
        "slot": 1
      },
      "budget_frames": 20000,
      "label": "host: the EARNED C1 handoff (tb/cloudreach-b 0883848d), loaded through Game.load_game: trainer at the Cloudreach arrival with its earned five"
    },
    {
      "peer": 1,
      "action": "boot",
      "args": {
        "scene": "world"
      },
      "budget_frames": 20000,
      "label": "DRY RUN guest: a fresh Meadows world (fixture guest; the earned flight checkpoint replaces this)"
    },
    {
      "peer": 1,
      "action": "story_flag",
      "args": {
        "flag": "realm_key_cloudreach",
        "scope": "world"
      },
      "label": "setup: both worlds hold the Cloudreach key"
    },
    {
      "peer": 1,
      "action": "story_flag",
      "args": {
        "flag": "fly_traversal_unlocked",
        "scope": "world"
      },
      "label": "setup: both worlds finished the Windscar flight trial (the Fly gate)"
    },
    {
      "peer": 1,
      "action": "story_flag",
      "args": {
        "flag": "cloudreach_upper_route_unlocked",
        "scope": "world"
      },
      "label": "setup: ONLY the guest's own world has the upper counterweight route open (a leak of its own world would show)"
    },
    {
      "peer": 1,
      "action": "party_grant",
      "args": {
        "species": "bramblebun",
        "level": 20
      }
    },
    {
      "peer": 1,
      "action": "party_grant",
      "args": {
        "species": "terrapup",
        "level": 20
      }
    },
    {
      "peer": 1,
      "action": "party_grant",
      "args": {
        "species": "brooktail",
        "level": 20
      }
    },
    {
      "peer": 1,
      "action": "party_grant",
      "args": {
        "species": "mudsnout",
        "level": 20
      }
    },
    {
      "peer": 1,
