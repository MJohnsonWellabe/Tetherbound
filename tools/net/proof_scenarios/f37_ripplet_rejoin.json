{
  "name": "F37 Ripplet surface mount, Dive and durable two-peer rejoin",
  "claim": "Pending runtime fixture proof only. Owned Ripplet and L30 breakthrough are explicit pre-admission fixtures. Real Interact/Jump, host admission, replicated carrier identity, disk character save and new-peer returning join. Save restores the mount at the surface with spent stamina and remaining dive debt, per WORLD 6.7. No earned feast, campaign, device or visual acceptance.",
  "peers": 2,
  "scene": "water",
  "budget_s": 1800,
  "steps": [
    {
      "peer": 1,
      "action": "f37_fixture",
      "args": {
        "breakthrough": true
      },
      "label": "SETUP before host admission: owned Ripplet and L30 feast record"
    },
    {
      "peer": 0,
      "action": "host"
    },
    {
      "peer": 1,
      "action": "join"
    },
    {
      "peer": "all",
      "action": "expect_peers",
      "args": {
        "count": 2
      }
    },
    {
      "peer": 0,
      "action": "water_fixture",
      "args": {
        "mode": "island",
        "island_id": "first_shore"
      },
      "label": "setup: host on the first shore"
    },
    {
      "peer": 1,
      "action": "f37_mount"
    },
    {
      "peer": 1,
      "action": "f37_status",
      "expect_data": {
        "mounted": true,
        "diving": false,
        "saddle_count": 0,
        "stone": false
      }
    },
    {
      "peer": 1,
      "action": "f37_deep_fixture",
      "label": "SETUP submerged-save area near Lantern Cove"
    },
    {
      "peer": "all",
      "action": "wait",
      "args": {
        "frames": 90
      }
    },
    {
      "peer": 1,
      "action": "f37_jump"
    },
    {
      "peer": 1,
      "action": "f37_status",
      "expect_data": {
        "mounted": true,
        "diving": true
      }
    },
    {
      "peer": "all",
      "action": "wait",
      "args": {
        "frames": 90
      }
    },
    {
      "peer": 1,
      "action": "rider_self",
      "expect_data": {
        "character_id": "$character1",
        "mounted": true,
        "mount_species": "ripplet",
        "swim_mode": 2,
        "realm": "water"
      },
      "label": "BEFORE: the guest's own ride"
    },
    {
      "peer": 0,
      "action": "rider_identity",
      "args": {
        "character_id": "$character1"
      },
      "expect_data": {
        "agree": true,
        "mount_species": "ripplet",
        "mount_swim_mode": 2,
        "seated": true,
        "body_visible_in_scene": true
      },
      "label": "BEFORE: the host's picture of that rider agrees"
    },
    {
      "peer": 1,
      "action": "save_character_here",
      "label": "the guest's character is written while mounted mid-water"
    },
    {
      "peer": "all",
      "action": "capture_saves",
      "args": {
        "label": "before_drop"
      }
    },
    {
      "peer": 1,
      "action": "f37_status",
      "args": {
        "remember_saved_dive": true
      },
      "expect_data": {
        "mounted": true,
        "diving": true,
        "saved_dive_recorded": true
      },
      "label": "Read the actual saved owned UID and spent Dive debt after production autosave"
    },
    {
      "peer": 1,
      "action": "check_saved",
      "args": {
        "label": "before_drop",
        "dir": "characters",
        "path_contains": "$character1",
        "contains": [
          "ripplet",
          "\"aquatic\"",
          "creature_uid",
          "remaining_s"
        ]
      },
      "label": "the saved character carries the ride"
    },
    {
      "peer": 1,
      "action": "drop_link",
      "args": {
        "settle_frames": 60
      }
    },
    {
      "peer": 0,
      "action": "expect_peers",
      "args": {
        "count": 1
      },
      "budget_frames": 900
    },
    {
      "peer": 1,
      "action": "leave",
      "args": {
        "reason": "link_died"
      },
      "expect": "any",
      "label": "tear down if anything is left (after a dropped link there is no session, as smoke_net_reconnect_keeps_character expects)"
    },
    {
      "peer": 1,
      "action": "f37_record_disconnect",
      "expect_data": {
        "saved_dive_recorded": true
      },
      "label": "Retain exact final disconnect-written debt before blanking live character"
    },
    {
      "peer": 1,
      "action": "wipe_character",
      "label": "the live character is blanked, so the ride must come back from the save"
    },
    {
      "peer": 1,
      "action": "production_join",
      "args": {
        "returning_route": true,
        "budget_frames": 6000,
        "character": {
          "character_id": "$character1",
          "display_name": "Trainer"
        }
      },
      "budget_frames": 6500
    },
    {
      "peer": "all",
      "action": "expect_peers",
      "args": {
        "count": 2
      }
    },
    {
      "peer": 1,
      "action": "await_probe",
      "args": {
        "what": "riding",
        "path": [
          "local",
          "mounted"
        ],
        "equals": true,
        "budget_frames": 1800
      },
      "label": "the ride is restored",
      "continue_on_fail": true,
      "_comment": "Original predicate and 1800 polls unchanged; a refusal remains counted FAIL. Continue only to retain actual terminal restore operands before the next original identity check."
    },
    {
      "peer": 0,
      "action": "f37_status",
      "args": {
        "observe_restore": true,
        "restore_peer": "$peer1"
      },
      "label": "Observe host retained mount answers for this returning peer; no request or retry"
    },
    {
      "peer": 1,
      "action": "f37_status",
      "args": {
        "observe_restore": true
      },
      "label": "Observe guest terminal pending state and actual eligibility; no request or retry"
    },
    {
      "peer": 1,
      "action": "rider_self",
      "expect_data": {
        "character_id": "$character1",
        "mounted": true,
        "mount_species": "ripplet",
        "swim_mode": 2,
        "realm": "water"
      },
      "label": "AFTER: the guest's own ride, same character"
    },
    {
      "peer": 0,
      "action": "await_probe",
      "args": {
        "what": "riding",
        "path": [
          "remote",
          "$peer1",
          "riding"
        ],
        "equals": true,
        "budget_frames": 1800
      },
      "label": "the host sees the new peer id riding"
    },
    {
      "peer": 0,
      "action": "await_probe",
      "args": {
        "what": "water_mounted",
        "path": [
          "remote_mounts",
          "$peer1",
          "owner_peer_id"
        ],
        "equals": "$peer1",
        "budget_frames": 1500
      },
      "label": "give the returning rider's mount time to reach the host (about 25 s)"
    },
    {
      "peer": 0,
      "action": "await_probe",
      "args": {
        "what": "water_mounted",
        "path": [
          "remote_mounts",
          "$peer1",
          "applied_aquatic",
          "mode"
        ],
        "equals": 2,
        "budget_frames": 900
      },
      "label": "the returning mount's swim mode reaches the host (race seen at tb/tidewake-full fa287aa4)"
    },
    {
      "peer": 0,
      "action": "rider_identity",
      "args": {
        "character_id": "$character1"
      },
      "expect_data": {
        "agree": true,
        "peer_id": "$peer1",
        "mount_species": "ripplet",
        "mount_swim_mode": 2,
        "seated": true,
        "stale_bodies": 0,
        "stale_mounts": 0
      },
      "label": "AFTER: the host's picture agrees, found by character, nothing stale"
    },
    {
      "peer": 1,
      "action": "f37_status",
      "expect_data": {
        "mounted": true,
        "diving": false,
        "saved_dive_matches": true
      },
      "label": "Reconnect seats surface, with remaining dive debt on saved owned mount",
      "args": {
        "require_saved_dive": "surface",
        "screenshot": "f37-rejoin-restored-surface"
      }
    },
    {
      "peer": 1,
      "action": "f37_jump"
    },
    {
      "peer": 1,
      "action": "f37_status",
      "expect_data": {
        "diving": true,
        "resumed_dive_within_saved": true
      },
      "label": "A fresh tap resumes the saved bounded dive budget",
      "args": {
        "require_saved_dive": "resumed",
        "screenshot": "f37-rejoin-resumed-dive"
      },
      "continue_on_fail": true,
      "_comment": "Original resumed Dive/debt predicate remains counted FAIL. Continue only for read-only terminal request/host-answer observations; no retry, wait or action."
    },
    {
      "peer": 0,
      "action": "f37_status",
      "args": {
        "observe_restore": true,
        "restore_peer": "$peer1"
      },
      "label": "Observe host retained action answers after the original resumed-Dive guard; no request or retry"
    },
    {
      "peer": 1,
      "action": "f37_status",
      "args": {
        "observe_restore": true
      },
      "label": "Observe guest pending request and actual eligibility after original resumed-Dive guard; no request or retry"
    }
  ]
}
